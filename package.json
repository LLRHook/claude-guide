{
  "name": "claude-guide",
  "version": "1.0.0",
  "type": "module",
  "description": "Training wheels for Claude Code. Always-on explanations and guard rails for non-developer users.",
  "bin": {
    "claude-guide": "./bin/cli.mjs"
  },
  "exports": {
    ".": "./bin/cli.mjs",
    "./hooks/pre-tool.mjs": "./hooks/pre-tool.mjs",
    "./hooks/post-tool.mjs": "./hooks/post-tool.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "setup": "npm link",
    "build:native": "node scripts/build-native.mjs",
    "prepare": "npm run build:native",
    "prepack": "npm run build:native",
    "install": "node scripts/install-native.mjs",
    "test:native": "node scripts/test-native.mjs",
    "pretest": "npm run build:native"
  },
  "files": [
    "bin/",
    "hooks/",
    "lib/",
    "data/",
    "README.md",
    "scripts/",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/build.rs",
    "native/src/",
    "native/*/guardrails.node"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": ["claude", "claude-code", "beginner", "training", "guard-rails"],
  "repository": {
    "type": "git",
    "url": "https://github.com/victorivanov/claude-guide"
  }
}
